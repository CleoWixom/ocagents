{
  "$schema": "https://opencode.ai/config.json",

  // Основной агент для новых сессий
  "default_agent": "builder",

  // Доступ к OpenRouter задайте через переменную среды.
  // Не записывайте API-ключ в этот файл.
  "model": "openrouter/z-ai/glm-5.3-flash",

  // По умолчанию спрашивать подтверждение для команд оболочки.
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },

    // Не читать и не редактировать секреты; примеры конфигов разрешены.
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" }
  ]
}
